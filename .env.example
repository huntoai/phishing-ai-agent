# API Keys Configuration

# OpenAI API Key for GPT-4o-mini (Pydantic AI)
HUNTO_MODEL_API_KEY=sk-your-openai-api-key-here

# Apollo.io API Key for employee data gathering
APOLLO_API_KEY=your-apollo-api-key-here

# Optional Enrichment Sources
BRAVE_API_KEY=your-brave-api-key-here
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# Email Sending Configuration
# Options: "simulation" (default, no emails sent) or "smtp" (actual email sending)
EMAIL_MODE=simulation

# SMTP Settings (required if EMAIL_MODE=smtp)
# For testing, use Mailtrap.io credentials (https://mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_USE_TLS=true

# Sender Configuration
SENDER_DOMAIN=securemail.test
SENDER_NAME=IT Security

# Test Email (for test_smtp.py script)
TEST_EMAIL=test@example.com

# Database Configuration
DATABASE_URL=sqlite:///phishing_agent.db

# Optional: PostgreSQL Database
# DATABASE_URL=postgresql://user:password@localhost/phishing_agent

